# Copy this file to ".env" and edit the values. NEVER commit ".env".
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env

# --- Required when DJANGO_DEBUG is False (optional for local development) ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret

# --- Optional ---
# Debug mode. Use True for local development only. Defaults to False.
DJANGO_DEBUG=True

# Comma-separated hostnames. Local default when DEBUG=True: localhost,127.0.0.1
# Required for a real deployment when DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with https://) for deployments behind a domain.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Production-only (used when DEBUG=False):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=0

# Optional, Render only: build.sh creates an admin account from these.
# Set them in the Render dashboard, never in a committed file.
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_FULL_NAME=Admin
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
